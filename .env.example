DATABASE_URL=postgresql://payload:payload@localhost:5434/sk_accounting
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Scaleway Object Storage (S3-compatible)
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud

# E-mailnotificatie contactformulier (Resend)
# RESEND_API_KEY: API-key uit het Resend-dashboard.
# CONTACT_NOTIFICATION_FROM: afzender op een GEVERIFIEERD domein in Resend (bv. noreply@sk-accounting.be).
# CONTACT_NOTIFICATION_TO: ontvanger; leeg laten = e-mailadres uit Site Settings (CMS).
RESEND_API_KEY=
CONTACT_NOTIFICATION_FROM=SK Accounting <noreply@sk-accounting.be>
CONTACT_NOTIFICATION_TO=

# Google Search Console — verificatie-token (content van de meta-tag) om het domein te claimen.
GOOGLE_SITE_VERIFICATION=
